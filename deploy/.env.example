# Copy to .env and fill in. Both are required.

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Your numeric Telegram user id — ask @userinfobot. Comma-separate for several.
# Anyone not listed is ignored, which is the only thing standing between your
# machine and whoever finds the bot.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional. Directories the agent may work in, inside the container.
# `label=/path` or a bare path. Clone your repos into /home/patchbay/ first.
# PATCHBAY_PROJECT_ROOTS=projects=/home/patchbay/projects

# Optional.
# TZ=Europe/Berlin
# PATCHBAY_REF=main
# PATCHBAY_MEM_LIMIT=8g
# PATCHBAY_CPUS=4.0
